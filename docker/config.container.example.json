{
  "workspacePath": "/workspaces/my-workspace",
  "agentDefinitionsPath": "/workspaces/my-workspace/agent/agents",
  "secretsPath": "/config/secrets.local.json",
  "runtimeDataPath": "/state/data",
  "runtimeHomePath": "/state/copilot",
  "skillDirectories": [
    "/workspaces/my-workspace/agent/skills"
  ],
  "ownerId": 1,
  "ownerName": "Alex",
  "permissionMode": "autopilot",
  "quietHours": {
    "start": "01:00",
    "end": "09:30",
    "timezone": "Europe/Kyiv"
  },
  "proactivity": {
    "minIntervalMs": 1800000,
    "maxActiveItemsPerAgent": 20
  },
  "claudeCode": {
    "homePath": "/state/claude",
    "defaultModel": "claude-sonnet-5-5"
  },
  "bots": [
    {
      "id": "example-bot",
      "agentId": "example-agent",
      "tokenRef": "telegram.example_bot_token"
    }
  ],
  "bindings": [
    {
      "botId": "example-bot",
      "chatId": 1,
      "kind": "private",
      "topicId": null
    }
  ],
  "mcp": {
    "mode": "none"
  },
  "audio": {
    "ffmpegPath": "/usr/bin/ffmpeg",
    "ffprobePath": "/usr/bin/ffprobe",
    "whisperPath": "/usr/local/bin/whisper-cli",
    "modelPath": "/models/ggml-small.bin",
    "language": "auto",
    "threads": 4
  },
  "coordinatorAgentId": "example-agent"
}

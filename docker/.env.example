# Copy to docker/.env (same folder). docker/.env is ignored by Git.
#
# Paths (required):
DENSEMBLE_INSTANCE=/absolute/path/to/instance
DENSEMBLE_WORKSPACES=/absolute/path/to/workspaces
DENSEMBLE_MODELS=/absolute/path/to/voice-models
#
# Linux only — workspace files keep your ownership:
# DENSEMBLE_UID=1000
# DENSEMBLE_GID=1000
#
# Optional instance name when running several stacks:
# DENSEMBLE_NAME=densemble
#
# Rough cut (optional). Leave these commented to keep empty placeholder mounts.
#
# CapCut drafts, mounted read-write at /workspaces/capcut_projects.
# The adapter writes draft_info.json here. Quote the value: the macOS path has spaces.
# CAPCUT_PROJECTS_DIR="/Users/you/Movies/CapCut/User Data/Projects/com.lveditor.draft"
#
# Media folders. Each absolute host path is mounted at that same path in the container,
# so a path stored in a CapCut draft opens without translation. Up to three. Read-only.
# SOURCE_DIR_1=/Users/you/Downloads
# SOURCE_DIR_2=/Users/you/Desktop
# SOURCE_DIR_3=/Users/you/Movies
#
# faster-whisper download root inside the container. /state is writable and survives
# a new image. Default: /state/models/whisper
# WHISPER_MODEL_DIR=/state/models/whisper
# Model name. Default: medium
# WHISPER_MODEL=medium
#
# One-time setup, once the container is up and the network is on. Job files for a run
# go to /state/jobs/<name>/. After the model download, transcription uses local files only.
#
#   docker compose -f docker/compose.yaml exec densemble /bin/bash
#   python3 -m venv /state/venvs/rough-cut
#   /state/venvs/rough-cut/bin/pip install faster-whisper
#   mkdir -p /state/models/whisper
#   /state/venvs/rough-cut/bin/python -c "from faster_whisper import WhisperModel; WhisperModel('medium', device='cpu', compute_type='int8', download_root='/state/models/whisper')"
